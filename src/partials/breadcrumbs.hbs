<nav class="breadcrumbs" aria-label="Breadcrumbs">
  <ul>
{{#with page.componentVersion}}
    <li><a href="{{{relativize ./url}}}">{{{./title}}}</a></li>
{{/with}}
{{#each page.breadcrumbs}}
{{#unless @last}}
    <li>{{#if ./url}}<a href="{{{relativize ./url}}}">{{{./content}}}</a>{{else}}<span>{{{./content}}}</span>{{/if}}</li>
{{/unless}}
{{/each}}
  </ul>
</nav>
