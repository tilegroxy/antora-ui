<nav class="breadcrumbs" aria-label="Breadcrumbs">
  <ul>
{{#each (breadcrumbTrail (eyebrow))}}
    <li{{#if ./eyebrow}} class="eyebrow"{{/if}}>{{#if ./text}}<span>{{./text}}</span>{{else if ./url}}<a href="{{{relativize ./url}}}">{{{./content}}}</a>{{else}}<span>{{{./content}}}</span>{{/if}}</li>
{{/each}}
  </ul>
</nav>
