<ul class="nav-list">
{{#each items}}
  <li class="nav-item{{#if (eq ./url @root.page.url)}} is-current-page{{/if}}{{#if ./items}} has-children{{/if}}">
    <div class="nav-row">
{{#if ./content}}
{{#if ./url}}
      <a class="nav-link" href="{{#if (eq ./urlType 'internal')}}{{{relativize ./url}}}{{else}}{{{./url}}}{{/if}}">{{{./content}}}</a>
{{else}}
      <span class="nav-text">{{{./content}}}</span>
{{/if}}
{{/if}}
{{#if ./items}}
      <button class="nav-item-toggle" aria-label="Expand {{detag ./content}}"></button>
{{/if}}
    </div>
{{#if ./items}}
{{> nav-list items=./items}}
{{/if}}
  </li>
{{/each}}
</ul>
