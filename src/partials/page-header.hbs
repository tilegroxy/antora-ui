<header class="page-header">
{{#with page.title}}
  <h1 class="page">{{{this}}}</h1>
{{/with}}
{{#with page.description}}
  <p class="lede">{{this}}</p>
{{/with}}
{{#if (or page.attributes.config-name page.attributes.config-key page.attributes.command page.attributes.tags)}}
  <div class="page-chips">
{{#with page.attributes.config-name}}
    <button class="chip chip-code" data-copy="name: {{this}}" title="Copy"><span class="chip-key">name:&nbsp;</span>{{this}}</button>
{{/with}}
{{#with page.attributes.config-key}}
    <span class="chip chip-code"><span class="chip-key">key:&nbsp;</span>{{this}}</span>
{{/with}}
{{#with page.attributes.command}}
    <button class="chip chip-code" data-copy="{{this}}" title="Copy"><span class="chip-key">$&nbsp;</span>{{this}}</button>
{{/with}}
{{#each (split page.attributes.tags)}}
    <span class="chip">{{this}}</span>
{{/each}}
  </div>
{{/if}}
</header>
