<header class="page-header">
  <div class="page-toolbar">
{{> breadcrumbs}}
    <div class="page-actions">
{{#with page.editUrl}}
{{#unless (startsWith this 'file:')}}
      <a href="{{{this}}}">Edit this page</a>
{{/unless}}
{{/with}}
{{#with site.keys.issues_url}}
      <a href="{{this}}">Report an issue</a>
{{/with}}
    </div>
  </div>
{{#with page.attributes.eyebrow}}
  <div class="eyebrow">{{this}}</div>
{{/with}}
{{#with page.title}}
  <h1 class="page">{{{this}}}</h1>
{{/with}}
{{#with page.description}}
  <p class="lede">{{this}}</p>
{{/with}}
{{#if (or page.attributes.config-name page.attributes.config-key page.attributes.command page.attributes.tags)}}
  <div class="page-chips">
{{#with page.attributes.config-name}}
    <button class="chip chip-code" data-copy="name: {{this}}" title="Copy"><span class="chip-key">name: </span>{{this}}</button>
{{/with}}
{{#with page.attributes.config-key}}
    <span class="chip chip-code"><span class="chip-key">key: </span>{{this}}</span>
{{/with}}
{{#with page.attributes.command}}
    <button class="chip chip-code" data-copy="{{this}}" title="Copy"><span class="chip-key">$ </span>{{this}}</button>
{{/with}}
{{#each (split page.attributes.tags)}}
    <span class="chip">{{this}}</span>
{{/each}}
  </div>
{{/if}}
</header>
