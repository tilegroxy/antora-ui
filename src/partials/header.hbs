<header class="header">
  <div class="header-inner">
    <button class="nav-toggle" aria-label="Toggle navigation" aria-controls="nav" aria-expanded="false"><span></span></button>
    <a class="brand" href="{{{or site.url (or siteRootUrl siteRootPath)}}}">
      <img class="brand-logo" src="{{{uiRootPath}}}/img/logo.svg" alt="" width="28" height="28">
{{#with (brandTitle site.title)}}
      <span class="brand-name">{{./name}}{{#if ./suffix}}<span class="brand-suffix"> {{./suffix}}</span>{{/if}}</span>
{{/with}}
{{#with page.componentVersion}}
{{#if (and ./version (ne ./version '~'))}}
      <span class="brand-version">{{./displayVersion}}</span>
{{/if}}
{{/with}}
    </a>
{{#if site.components}}
    <nav class="manuals" aria-label="Manuals">
{{#each (manuals)}}
      <a class="manual{{#if (eq ./name @root.page.component.name)}} is-current{{/if}}" href="{{{relativize ./url}}}">{{{./title}}}</a>
{{/each}}
    </nav>
{{/if}}
    <div class="header-search">
{{#if env.SITE_SEARCH_PROVIDER}}
      <button class="search-toggle" type="button" aria-label="Search" aria-controls="search-field" aria-expanded="false">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12.6 12.6 17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <div id="search-field" class="field search">
        <input id="search-input" type="search" placeholder="Search docs, options, commands" autocomplete="off">
        <kbd class="search-kbd">⌘K</kbd>
      </div>
{{/if}}
    </div>
    <div class="header-links">
{{#with (repoLinks)}}
{{#if ./repo}}
      <a href="{{./repo}}">{{./repoLabel}}</a>
{{/if}}
{{#if ./issues}}
      <a href="{{./issues}}">Issues</a>
{{/if}}
{{#if ./releases}}
      <a class="button" href="{{./releases}}">Get {{./product}}</a>
{{/if}}
{{/with}}
    </div>
{{#if themeToggle}}
{{> theme-toggle}}
{{/if}}
  </div>
</header>
