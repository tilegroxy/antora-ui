{{#unless (eq page.attributes.pagination undefined)}}
{{#if (or page.previous page.next)}}
<nav class="pagination">
{{#with page.previous}}
  <a class="prev" href="{{{relativize ./url}}}"><span class="pagination-label">← Previous</span><span class="pagination-title">{{{./content}}}</span></a>
{{else}}
  <span></span>
{{/with}}
{{#with page.next}}
  <a class="next" href="{{{relativize ./url}}}"><span class="pagination-label">Next →</span><span class="pagination-title">{{{./content}}}</span></a>
{{/with}}
</nav>
{{/if}}
{{/unless}}
